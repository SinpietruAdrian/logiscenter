<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="quote_metadata" resource="default" engine="innodb" comment="Quote Metadata Table">
        <column xsi:type="int" name="metadata_id" unsigned="true" nullable="false" identity="true"
                comment="Entity Id"/>
        <column xsi:type="int" name="quote_id" unsigned="true" nullable="false" comment="Quote ID FK"/>
        <column xsi:type="smallint" name="is_immutable" nullable="false" default="1" comment="Immutable Quote Flag"/>
        <!--        The purpose of this column is to have a user-friendly text for the quotes listing-->
        <column xsi:type="varchar" name="title" nullable="false" length="512" comment="Quote Title"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="metadata_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="QUOTE_ENTITY_ID_QUOTE_METADATA_QUOTE_ID"
                    table="quote_metadata" column="quote_id" referenceTable="quote"
                    referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>

    <table name="immutable_quote_action_log" resource="default" engine="innodb" comment="Immutable Quote Action Log">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="ID"/>
        <column xsi:type="varchar" name="action" nullable="false" length="255" comment="Action"/>
        <column xsi:type="varchar" name="ip" nullable="false" length="128" comment="IP Address"/>
        <column xsi:type="text" name="additional_information" nullable="true" comment="Additional Information"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true" comment="Customer ID"/>
        <column xsi:type="int" name="admin_user_id" unsigned="true" nullable="true" comment="Admin User ID"/>
        <column xsi:type="varchar" name="user_type" nullable="false" length="32" comment="User Type"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="IMMUTABLE_QUOTE_ACTION_LOG_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="immutable_quote_action_log"
                    column="customer_id"
                    referenceTable="customer_entity"
                    referenceColumn="entity_id"/>
        <constraint xsi:type="foreign" referenceId="IMMUTABLE_QUOTE_ACTION_LOG_ADMIN_USER_ID_ADMIN_USER_USER_ID"
                    table="immutable_quote_action_log"
                    column="admin_user_id"
                    referenceTable="admin_user"
                    referenceColumn="user_id"/>
    </table>
</schema>
