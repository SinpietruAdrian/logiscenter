						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"let rawData = pm.response.text();",
							"",
							"if (rawData && rawData.length > 0) {",
							"    let token = JSON.parse(rawData);",
							"    pm.collectionVariables.set(\"TOKEN\", token);",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
